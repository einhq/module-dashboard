{
  "name": "dashboard",
  "version": "0.1.7",
  "description": "Dashboards: pages of cards the installed modules offer — the time, what is coming up, a picture of the day, a device's readings, a todo list — arranged by whoever makes one, shown full screen on a wall, and on screens that never sign in through a display link",
  "license": "MIT",
  "coreApi": "^0.14.20",
  "exports": {
    "./api": "./lib/api.ts"
  },
  "imports": {
    "@dashboard/catalog": "./lib/catalog.ts",
    "@dashboard/edit": "./lib/edit.ts",
    "@dashboard/layout": "./lib/layout.ts",
    "@dashboard/show": "./lib/show.ts",
    "@dashboard/store": "./lib/store.ts",
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@std/path": "jsr:@std/path@^1.1.3",
    "@std/yaml": "jsr:@std/yaml@^1.0.11"
  },
  "roots": [
    "/archive/dashboards"
  ],
  "ui": {
    "routes": {
      "/dashboards": "ui/pages/dashboards.tsx",
      "/dashboards/new": "ui/pages/new-dashboard.tsx",
      "/dashboards/settings": "ui/pages/dashboard-settings.tsx",
      "/dashboards/add": "ui/pages/add-card.tsx",
      "/dashboards/card": "ui/pages/card-settings.tsx",
      "/dashboards/:name": "ui/pages/dashboard.tsx",
      "/dashboard-wall/:name": "ui/pages/wall.tsx",
      "/cards/dashboard/clock": "ui/cards/clock.tsx",
      "/cards/dashboard/coming-up": "ui/cards/coming-up.tsx",
      "/cards/dashboard/on-this-day": "ui/cards/on-this-day.tsx",
      "/cards/dashboard/news": "ui/cards/news.tsx",
      "/cards/dashboard/device": "ui/cards/device.tsx",
      "/cards/dashboard/reading": "ui/cards/reading.tsx",
      "/cards/dashboard/note": "ui/cards/note.tsx"
    },
    "open": {
      "/archive/dashboards/": "/dashboards/{rest}"
    },
    "shareLinks": {
      "/archive/dashboards/": {
        "shows": "account",
        "noun": "dashboard"
      }
    }
  }
}
