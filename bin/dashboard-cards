#!ts
/** dashboard-cards — the cards the installed modules offer, from their etc/dashboard.d/cards.json: all of them, or those named. */
import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags } from '@ein/client';
import type { CardBrief, CardOffer } from '@dashboard/api';
import { readCatalog } from '@dashboard/catalog';
import { DashboardError, fail } from '@dashboard/store';

/** What `--brief` keeps of an offer: a list of every card short enough to be read whole. */
const briefOf = (offer: CardOffer): CardBrief => {
  const required = offer.params.required ?? [];
  return {
    id: offer.id,
    label: offer.label,
    description: offer.description,
    settings: Object.keys(offer.params.properties),
    ...(required.length > 0 ? { required } : {}),
  };
};

const dashboardCards = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { boolean: ['brief'], unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  try {
    const { offers, problems } = await readCatalog(cmd);
    const named = flags._.map(String);
    for (const id of named) {
      if (!offers.some((offer) => offer.id === id)) throw new DashboardError(`no module offers ${id}; dashboard-cards --brief lists the cards there are`);
    }
    const listed = named.length > 0 ? offers.filter((offer) => named.includes(offer.id)) : offers;
    // A module's broken list is its own to fix: said, and the rest offered.
    for (const problem of problems) await cmd.writeError(`dashboard-cards: ${problem}\n`);
    if (flags.brief) {
      const briefs = listed.map(briefOf);
      if (cmd.json) await cmd.writeJSON(briefs satisfies CardBrief[]);
      else for (const brief of briefs) await cmd.writeLn(`${brief.id}  ${brief.label}  ${brief.settings.join(', ') || '-'}`);
    } else if (cmd.json) await cmd.writeJSON(listed satisfies CardOffer[]);
    else for (const offer of listed) await cmd.writeLn(`${offer.id}  ${offer.label}  ${offer.size.join('x')}  ${offer.description}`);
    return 0;
  } catch (error) {
    return await fail(cmd, 'dashboard-cards', error);
  }
};

dashboardCards.spec = {
  name: 'dashboard-cards',
  effect: 'read' as const,
  description: 'List the cards the installed modules offer for dashboards',
  args: [{ name: 'card', type: 'string' as const, description: 'only these cards, as <module>.<name> (default every one)', variadic: true }],
  flags: [{ name: 'brief', type: 'bool' as const, description: "each card's id, label, description and the names of its settings, without the rest" }],
  examples: ['dashboard-cards --brief', 'dashboard-cards dashboard.coming-up'],
  returns:
    'One entry per card: id (<module>.<name>), module, name, label, description, icon, color, route, frame, size, min, and params, a JSON Schema of what it takes. With --brief: id, label, description, settings (the names in params) and required.',
};

export default dashboardCards;
